// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  USER
  MONITER
}

enum RevenueType {
  monthly
  yearly
}

enum AnswerType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  DATE
  FILE
  PHOTO
  URL
  CHECKBOX
}

enum AnswerFor {
  BRAND
  PRODUCT
  MANAGEMENT
  STATISTIC
  HANDOVER
  SOCIAL
  ADVERTISMENT
}

enum TicketStatus {
  OPEN
  CLOSED
  PENDING
}

enum ListingStatus {
  PUBLISH
  DRAFT
  // Set by the platform team once the business has been sold. A sold listing
  // leaves the public marketplace and its package billing stops.
  SOLD
  // Taken off the marketplace by the team. Unlike SOLD this is a moderation
  // action: the owner still sees it under My Listings, can edit it to fix
  // whatever was wrong, but cannot publish it again themselves.
  BLOCKED
}

enum ChatStatus {
  ACTIVE
  CLOSED
  FLAGGED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum BillingCycle {
  MONTHLY
  // The client's cycles: three months at 10% off, six at 20%.
  THREE_MONTH
  SIX_MONTH
  // Kept so existing rows stay readable; not offered on the new page.
  YEARLY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

/// Where a member's invoices are addressed.
///
/// Kept apart from the profile address: a company and its VAT number are
/// billing details, not personal ones, and a business may be billed somewhere
/// other than where its owner lives. Copied to the Stripe customer on save, so
/// the invoices Stripe issues from then on carry it.
type InvoiceAddress {
  company    String?
  vat_number String?
  first_name String?
  last_name  String?
  street     String?
  zip_code   String?
  city       String?
  state      String?
  /// ISO 3166-1 alpha-2: the only form Stripe prints.
  country    String?
}

model User {
  id                   String          @id @default(uuid()) @map("_id")
  first_name           String?
  last_name            String?
  /// Enforced by the database, not only by the application. A duplicate
  /// address makes every account but the oldest unreachable at sign-in, which
  /// looks like "the password change did nothing".
  email                String          @unique

  /// The one Stripe customer this person is billed as.
  ///
  /// It used to live only on `UserSubscription`, a row that exists only for
  /// people who bought a buyer plan — so a seller buying listing packages got
  /// a new Stripe customer on every checkout, and with it a new card to enter
  /// and a credit balance they could never spend. It belongs to the person.
  ///
  /// Not unique, though it is one-to-one in practice: MongoDB counts every
  /// absent value as the same value, so a unique index here refuses the second
  /// user who has not bought anything yet. Two people cannot land on one
  /// customer anyway — it is looked up by the user's own email address.
  stripeCustomerId     String?
  /// Where invoices are addressed. See InvoiceAddress.
  invoice_address      InvoiceAddress?
  business_name        String?
  contact_name         String?
  phone                String?
  country_code         String?
  address              String?
  country              String?
  permissions          String[]
  role                 Role
  city                 String?
  state                String?
  refresh_token        String?
  password_hash        String
  otp_code             String?
  /// When `otp_code` stops working. It proves someone reads this inbox — to
  /// confirm the address, or to reset a password — and once it is emailed a
  /// code with no expiry is a key for ever.
  otp_expires_at       DateTime?
  /// Wrong guesses at the current `otp_code`.
  otp_attempts         Int             @default(0)
  profile_pic          String?
  is_online            Boolean?        @default(false)
  last_offline         DateTime?
  zip_code             String?
  /// Plain `YYYY-MM-DD`, not a DateTime. A birthday has no time of day, and
  /// storing one lets a timezone shift move it to the day before.
  birthday             String?
  background           String?
  is_email_verified    Boolean         @default(false)
  support_ticket       SupportTicket[]
  is_phone_verified    Boolean         @default(false)
  /// The number waiting to be confirmed. `phone` only changes once the code
  /// checks out, so a typo cannot leave someone with an unreachable number.
  pending_phone        String?
  phone_otp            String?
  /// Codes expire. Without this a code stays valid forever, which turns one
  /// intercepted SMS into a permanent key.
  phone_otp_expires_at DateTime?
  /// Guesses used on the current code. Six digits with unlimited tries is not
  /// a secret.
  phone_otp_attempts   Int             @default(0)
  /// The address waiting to be confirmed. `email` — which is how someone signs
  /// in — only changes once a code sent to the new address comes back, so a
  /// typo cannot lock its owner out of their own account.
  pending_email        String?
  email_otp            String?
  email_otp_expires_at DateTime?
  email_otp_attempts   Int             @default(0)
  /// Identity check with didit.me. `verified` above is the platform's own
  /// answer; these record where the provider's session got to, so a webhook
  /// arriving out of order can be matched to the right attempt.
  /// Not `@unique`: MongoDB counts every null as the same value in a plain
  /// unique index, so the constraint cannot be built while most accounts have
  /// no session. Nothing relies on it — the webhook looks the session up with
  /// findFirst, and the ids are provider-generated UUIDs.
  identity_session_id  String?
  /// The provider's own wording — "Approved", "Declined", "In Review"… kept
  /// verbatim rather than flattened, so support can see what they saw.
  identity_status      String?
  identity_checked_at  DateTime?
  verified             Boolean         @default(false)

  /// Moderation state. Kept separate from `verified`, which is a KYC flag:
  /// an unverified user is not a blocked one.
  blocked        Boolean   @default(false)
  blocked_at     DateTime?
  blocked_reason String?
  /// Who pulled the trigger, for the audit trail.
  blocked_by     String?

  /// Last sign of life. Presence is "socket connected OR active recently", so
  /// moving between tabs no longer drops a user to offline.
  last_seen DateTime?

  favourite Favourite[]

  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt
  deleted_at                 DateTime?
  buyer                      Chat[]            @relation("Buyer")
  seller                     Chat[]            @relation("Seller")
  listing                    Listing[]
  // Listings this team member has been assigned to look after.
  assignedListings           Listing[]         @relation("ListingResponsible")
  // Conversations this team member has been assigned to look after.
  assignedChats              Chat[]            @relation("ChatResponsible")
  preferences                Preference?
  chatRoomId                 String?
  chatlabels                 ChatLabel[]
  Message                    Message[]         @relation("Sender")
  ChatMonitor                ChatMonitor[]     @relation("ChatMonitor")
  ActivityLog                ActivityLog[]
  AdminFinancial             AdminFinancial[]
  Notification               Notification[]
  MonitoringAlertReporter    MonitoringAlert[] @relation("AlertReporter")
  MonitoringAlertProblematic MonitoringAlert[] @relation("AlertProblematic")
  MonitoringAlertResponsible MonitoringAlert[] @relation("AlertResponsible")

  acquisitionCapacity             AcquisitionCapacity?        @relation("CapacityBuyer")
  reviewedCapacities              AcquisitionCapacity[]       @relation("CapacityReviewer")
  subscription                    UserSubscription?
  payments                        Payment[]
  confidentialListingAccesses     ListingConfidentialAccess[] @relation("ConfidentialAccessBuyer")
  confidentialListingAccessGrants ListingConfidentialAccess[] @relation("ConfidentialAccessSeller")
}

/// Status of a buyer's proof-of-funds review.
enum AcquisitionCapacityStatus {
  UNASSIGNED
  IN_REVIEW
  COMPLETED
}

/// A buyer's verified purchasing power.
///
/// The buyer uploads proof of funds; a moderator reviews it and records the
/// amount they could verify. Listings then compare that amount against their
/// asking price to show how realistic the buyer is. One record per buyer.
model AcquisitionCapacity {
  id      String @id @default(uuid()) @map("_id")
  buyerId String @unique
  buyer   User   @relation("CapacityBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  /// Uploaded proof-of-funds files, as bare URLs. Superseded by the
  /// `uploads` relation, which carries a name, a date and its own status —
  /// kept only so nothing already stored is lost.
  documents     String[]                  @default([])
  /// One row per uploaded file, each reviewed on its own.
  uploads       AcquisitionDocument[]
  /// Amount the moderator could actually verify. Null until reviewed.
  verifiedFunds Float?
  status        AcquisitionCapacityStatus @default(UNASSIGNED)
  /// Internal moderator notes; never shown to sellers or buyers.
  notes         String?

  reviewerId String?
  reviewer   User?     @relation("CapacityReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([reviewerId])
}

/// Where one uploaded proof-of-funds file stands.
enum AcquisitionDocumentStatus {
  IN_REVIEW
  VERIFIED
  DECLINED
}

/// A single proof-of-funds file.
///
/// Documents are judged one at a time: a buyer may send a bank statement that
/// checks out and a screenshot that does not, and the account page shows each
/// with its own outcome rather than one verdict over the pile.
model AcquisitionDocument {
  id              String                    @id @default(uuid()) @map("_id")
  capacityId      String
  capacity        AcquisitionCapacity       @relation(fields: [capacityId], references: [id], onDelete: Cascade)
  /// What the buyer's file was called, e.g. "IMG3483.png".
  name            String
  url             String
  status          AcquisitionDocumentStatus @default(IN_REVIEW)
  /// Why it was declined, if it was. Shown to the buyer.
  note            String?
  /// What this one document actually proves, as judged by the moderator. The
  /// case total is the sum of these across verified documents — it is never
  /// typed by hand, so the figure and its evidence cannot drift apart.
  verifiedCapital Float?
  reviewedAt      DateTime?
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt

  @@index([capacityId])
  @@index([status])
}

model MonitoringAlert {
  id           String   @id @default(uuid()) @map("_id")
  problem_type String
  status       String   @default("unsolved")
  notes        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  reporterId String?
  reporter   User?   @relation("AlertReporter", fields: [reporterId], references: [id])

  problematicUserId String?
  problematic_user  User?   @relation("AlertProblematic", fields: [problematicUserId], references: [id])

  responsibleId String?
  responsible   User?   @relation("AlertResponsible", fields: [responsibleId], references: [id])

  // Set when the alert is a report about a listing rather than about a user.
  listingId String?
  listing   Listing? @relation("AlertListing", fields: [listingId], references: [id], onDelete: Cascade)

  /// Set when the alert is about a conversation. Until now the chat id was
  /// scraped out of the `notes` text, which meant the link broke the moment
  /// anyone reworded a note — and a reported chat had nowhere to be recorded.
  chatId String?
  chat   Chat?   @relation("AlertChat", fields: [chatId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([chatId])
  @@index([status])
}

model ActivityLog {
  id            String   @id @default(uuid()) @map("_id")
  actorId       String?
  actorRole     Role?
  /// The member the entry is about: the actor for what they did themselves,
  /// the member for what the team did to them, empty for team work about no
  /// one in particular. A member's Logs tab lists both sides.
  subjectUserId String?
  action        String
  entityType    String
  entityId      String?
  /// A short line saying what happened. Before September 2026 this held the
  /// whole submitted form, passwords included;
  /// scripts/strip-activity-log-secrets.js cleans those.
  message       String
  ipAddress     String?
  /// The browser's description of itself.
  userAgent     String?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([createdAt])
}

model Favourite {
  id String @id @default(uuid()) @map("_id")

  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([listingId])
}

model Preference {
  id String @id @default(uuid()) @map("_id")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessCategory BusinessCategory[]
  niche            Niche[]
  financial        Financial?
}

model Financial {
  id              String  @id @default(uuid()) @map("_id")
  seller_location String?

  age_range              Range? @relation("ageRange")
  yearly_profit_range    Range? @relation("yearlyProfitRange")
  profit_multiple_range  Range? @relation("profitMultipleRange")
  revenue_multiple_range Range? @relation("revenueMultipleRange")

  preferenceId String?     @unique
  preference   Preference? @relation(fields: [preferenceId], references: [id])
}

model Range {
  id         String   @id @default(uuid()) @map("_id")
  min        String
  max        String
  country    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  age_id              String @unique
  yearly_profit_id    String @unique
  profit_multiple_id  String @unique
  revenue_multiple_id String @unique

  age              Financial? @relation("ageRange", fields: [age_id], references: [id])
  yearly_profit    Financial? @relation("yearlyProfitRange", fields: [yearly_profit_id], references: [id])
  profit_multiple  Financial? @relation("profitMultipleRange", fields: [profit_multiple_id], references: [id])
  revenue_multiple Financial? @relation("revenueMultipleRange", fields: [revenue_multiple_id], references: [id])
}

model Listing {
  id                          String                      @id @default(uuid()) @map("_id")
  status                      ListingStatus
  user                        User                        @relation(fields: [userId], references: [id])
  userId                      String
  // Team member this listing is assigned to. The admin table was already
  // sending this, but there was nowhere to store it, so every assignment was
  // silently discarded.
  responsible                 User?                       @relation("ListingResponsible", fields: [responsibleId], references: [id])
  responsibleId               String?
  // Why the team blocked it, shown to the owner so a blocked listing does not
  // simply become a support ticket.
  blockedReason               String?
  brand                       ListingQuestion[]           @relation("BrandQuestion")
  category                    ListingCategory[]
  tools                       ListingTool[]
  financials                  Revenue[]
  attachments                 Attachment[]
  statistics                  ListingQuestion[]           @relation("StatisticQuestion")
  productQuestion             ListingQuestion[]           @relation("ProductQuestion")
  managementQuestion          ListingQuestion[]           @relation("ManageQuestion")
  social_account              ListingQuestion[]           @relation("SocialQuestion")
  advertisement               ListingQuestion[]           @relation("AdvertisementQuestion")
  handover                    ListingQuestion[]           @relation("HandoverQuestion")
  portfolioLink               String?
  managed_by_ex               Boolean                     @default(false)
  confidentialControl         Boolean                     @default(false)
  featuredOnCategoryPage      Boolean                     @default(false)
  featuredOnStartPage         Boolean                     @default(false)
  // Package the seller chose for this listing. These record the selection and
  // the success-fee rate quoted at that moment (so a later listing-price change
  // does not silently re-price the deal). The paid features themselves are
  // switched on once payment is wired up. Null = legacy listing / no package.
  selectedPackage             String?
  packageBillingCycle         String?
  packageAddons               String[]                    @default([])
  successFeePercent           Float?
  approveBuyersManually       Boolean?
  /**
   * When the team marked this listing as sold. Null while it is still for sale.
   */
  soldAt                      DateTime?
  // Paid state of the package. `selectedPackage` above is only what the seller
  // picked; these say whether it was actually paid for and until when. Premium
  // features are gated on packageActive, so an expired package silently loses
  // them while the listing itself stays public.
  packageActive               Boolean?
  packageExpiresAt            DateTime?
  /// Set when the seller cancels the package: the day it actually stops.
  ///
  /// Not the same as `packageExpiresAt`, which is simply when the period being
  /// paid for ends and a new one begins. This one says no new period is coming,
  /// while the seller keeps everything until the date. Reactivating clears it.
  packageEndsAt               DateTime?
  packageStripeSubscriptionId String?
  addonStripeSubscriptionId   String?
  // How often the add-on renews. Its own cycle, not the package's: the two are
  // chosen separately and Stripe cannot hold both intervals in one subscription.
  addonBillingCycle           String?
  // A cancelled add-on keeps its placement until the month it was paid for
  // runs out. This is when that happens; null means no removal is pending.
  addonEndsAt                 DateTime?

  /// A downgrade takes effect at the end of the paid period, not on the click.
  ///
  /// The same rule the buyer plans already follow: an upgrade is paid for and
  /// starts at once, a downgrade waits until the period the seller has already
  /// paid for runs out. Until then they keep what they bought, the page can say
  /// when the change lands, and they can still change their mind — none of
  /// which is possible without remembering the pending change.
  pendingPackage            String?
  pendingPackageCycle       String?
  pendingPackageChangeAt    DateTime?
  /// The placements this listing is paying for. See `ListingAddon`.
  ///
  /// `packageAddons` above is kept in step with these rows so the admin panel
  /// and the feed keep reading the field they already read; these rows are the
  /// truth, that array is the summary.
  addons                      ListingAddon[]
  confidentialAccesses        ListingConfidentialAccess[]
  Favourite                   Favourite[]
  chats                       Chat[]                      @relation // CRITICAL: Link to chats for this listing
  reports                     MonitoringAlert[]           @relation("AlertListing")
  /// The currency the seller prices and reports in (ISO code). Copied from the
  /// financial table on every save; USD for a listing that never chose one.
  currency                    String?
  /// Its money in every currency, worked out ahead of time so filters and
  /// sorting never touch a live rate. See `src/fx/listing-fx.ts`.
  fx                          Json?
  created_at                  DateTime                    @default(now())
  updated_at                  DateTime                    @updatedAt
  deleted_at                  DateTime?

  // Feed queries filter by status + userId and order by created_at desc.
  @@index([status, created_at])
  @@index([userId])
}

/// Where a buyer's request for the confidential details currently stands.
enum ConfidentialAccessStatus {
  /// The seller vets buyers by hand and has not decided yet.
  PENDING
  APPROVED
  DECLINED
}

model ListingConfidentialAccess {
  id                String                   @id @default(uuid()) @map("_id")
  listingId         String
  buyerId           String
  grantedBySellerId String
  chatId            String?
  /// Defaults to APPROVED because every row written before this existed was a
  /// grant — a stricter default would revoke access people already had.
  status            ConfidentialAccessStatus @default(APPROVED)
  /// When the seller approved or declined. Null while still waiting.
  decidedAt         DateTime?
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt

  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer           User    @relation("ConfidentialAccessBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  grantedBySeller User    @relation("ConfidentialAccessSeller", fields: [grantedBySellerId], references: [id], onDelete: Cascade)
  chat            Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([listingId, buyerId])
  @@index([listingId])
  @@index([buyerId])
}

model ListingCategory {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model BusinessCategory {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Preference   Preference? @relation(fields: [preferenceId], references: [id])
  preferenceId String?
}

model BusinessCategoryOption {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Niche {
  id String @id @default(uuid()) @map("_id")

  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Preference   Preference? @relation(fields: [preferenceId], references: [id])
  preferenceId String?
}

model NicheOption {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Plan {
  id          String @id @default(uuid()) @map("_id")
  name        String @unique
  slug        String @unique
  title       String
  description String

  // Legacy fields (keep for backward compatibility)
  duration_type String?
  type          String?
  price         String?
  feature       String[] @default([])

  // New pricing fields
  monthlyPrice String @default("0")
  yearlyPrice  String @default("0")

  // Stripe IDs
  stripeMonthlyPriceId    String?
  stripeYearlyPriceId     String?
  // The client's discounted cycles bill a different amount, so each needs its
  // own Stripe price. Without these the 3- and 6-month options cannot be sold.
  stripeThreeMonthPriceId String?
  stripeSixMonthPriceId   String?
  stripeProductId         String?

  // Feature limits
  maxListings      Int     @default(0)
  maxPhotos        Int     @default(5)
  maxVideoDuration Int     @default(0)
  canUseAnalytics  Boolean @default(false)
  prioritySupport  Boolean @default(false)
  featuredListing  Boolean @default(false)
  canBoostListing  Boolean @default(false)
  customBranding   Boolean @default(false)

  // Metadata
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  subscriptions UserSubscription[]
  payments      Payment[]
}

model EmailTemplate {
  id         String   @id @default(uuid()) @map("_id")
  subject    String
  cc         String[]
  body       String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Category {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  image_path String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ServiceTool {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  image_path String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ListingTool {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String?

  @@index([listingId])
}

model Brand {
  id                String   @id @default(uuid()) @map("_id")
  name              String
  domain            String[]
  business_location String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  listingId         String?  @unique
}

model Revenue {
  id             String      @id @default(uuid()) @map("_id")
  type           RevenueType
  name           String
  revenue_amount String
  annual_cost    String
  net_profit     String?
  listingId      String
  listing        Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@index([listingId])
}

model ListingQuestion {
  id                   String      @id @default(uuid()) @map("_id")
  question             String?
  answer_for           String?
  answer_type          AnswerType?
  answer               String?
  option               String[]
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  brandQuestionId      String?
  brandQuestion        Listing?    @relation("BrandQuestion", fields: [brandQuestionId], references: [id], onDelete: Cascade)
  productQuestion      Listing?    @relation("ProductQuestion", fields: [productQuestionId], references: [id], onDelete: Cascade)
  productQuestionId    String?
  managementQuestion   Listing?    @relation("ManageQuestion", fields: [managementQuestionId], references: [id], onDelete: Cascade)
  managementQuestionId String?
  handoverQuestion     Listing?    @relation("HandoverQuestion", fields: [handoverQuestionId], references: [id], onDelete: Cascade)
  handoverQuestionId   String?
  statistics           Listing?    @relation("StatisticQuestion", fields: [statisticsId], references: [id], onDelete: Cascade)
  statisticsId         String?
  advertisement        Listing?    @relation("AdvertisementQuestion", fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId      String?
  social_account       Listing?    @relation("SocialQuestion", fields: [social_accountId], references: [id], onDelete: Cascade)
  social_accountId     String?

  // Each relation on Listing resolves by one of these FKs; index them all so
  // including questions in the feed is a lookup instead of a collection scan.
  @@index([brandQuestionId])
  @@index([productQuestionId])
  @@index([managementQuestionId])
  @@index([handoverQuestionId])
  @@index([statisticsId])
  @@index([advertisementId])
  @@index([social_accountId])
}

model AdminQuestion {
  id                  String     @id @default(uuid()) @map("_id")
  question            String
  answer_type         AnswerType
  answer_for          AnswerFor // brand, product, management
  option              String[]   @default([])
  // Optional conditional display: show this question only when another question's
  // answer equals dependsOnValue. Both null = always show (default, unchanged behavior).
  dependsOnQuestionId String?
  dependsOnValue      String?
  // Whether the seller must answer this question. Null = legacy behaviour
  // (each step keeps its current default), so existing questions are unchanged.
  required            Boolean?
  /// The category this question belongs to, as a `Category.id`.
  ///
  /// One set of questions used to serve every category, so an e-commerce
  /// seller and a plumber were asked the same things. Each category now owns
  /// its own set.
  ///
  /// Null means the question belongs to no category. Those are the originals:
  /// they are what a new category is seeded from, and no seller is shown them
  /// once the wizard asks by category. Kept as a scalar rather than a relation
  /// because `Category` has nothing to say about questions in return.
  categoryId          String?
  /// Help for the seller, shown under the field while the listing is written.
  ///
  /// The dialog has had a box for this for a long time; nothing ever read it
  /// back or wrote it down, so whatever an administrator typed was discarded
  /// when the dialog closed.
  hint                String?
  /// Help for the buyer, shown as the ⓘ beside the figure on the published ad.
  ///
  /// Those tooltips were sentences written into the page. This is the same
  /// text, kept where an administrator can edit it. Left empty, the page keeps
  /// the wording it already had.
  publicHint          String?
  /// Whether a visitor who is not signed in may read this statistic on a
  /// published listing ("Visible without registration?" in the admin dialog).
  ///
  /// Null means nobody has set it, and the rule in listing-visibility.ts
  /// decides as it always has: Returning customers and Refund rate shown,
  /// every other statistic held back. So existing questions are unchanged
  /// until an administrator flips one.
  visibleWithoutRegistration Boolean?
  /// Where this question sits in its step, smallest first.
  ///
  /// There was no such field: the list came back in whatever order the
  /// database happened to hold it, which looked like an order and was not one —
  /// nothing guaranteed it, and nobody could change it. Ordering is per
  /// category, because the questions are.
  ///
  /// Null on a question written before this existed, or by a caller that does
  /// not set it; those sort after the numbered ones, by age, so nothing jumps
  /// about until somebody arranges it.
  position            Int?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  @@index([categoryId])
  @@index([answer_for, categoryId])
}

model AdminSocialAccount {
  id                    String   @id @default(uuid()) @map("_id")
  social_account_option String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model AdminFinancial {
  id         String   @id @default(uuid()) @map("_id")
  columns    String[] @default([])
  rows       Json     @default("[]")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// The order the listing form asks its areas in, as an administrator arranged
/// them by dragging in the Content Management menu.
///
/// A single document, id "default". Category and Packages are not in it: they
/// keep the first and last places whatever the rest do. The id is fixed rather
/// than generated, so there is nothing to look up and no index to create.
model ListingAreaOrder {
  id         String   @id @map("_id")
  /// Content Management slugs, first to last — `brand-info`, `tools`, …
  areas      String[] @default([])
  updated_at DateTime @updatedAt
}

model Question {
  id          String     @id @default(uuid()) @map("_id")
  question    String
  answer_type AnswerType
  option      String[]
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
}

// User Chat System
model Chat {
  id     String @id @default(uuid()) @map("_id")
  user   User   @relation("Buyer", fields: [userId], references: [id])
  userId String
  seller User   @relation("Seller", fields: [sellerId], references: [id])

  sellerId             String
  listingId            String? // CRITICAL: Links chat to specific listing
  listing              Listing?                    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages             Message[]
  monitorViews         ChatMonitor[]               @relation("MoniteredChat")
  isOffered            Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  offer                String? // Optional offer text/ID made by seller
  status               ChatStatus                  @default(ACTIVE)
  chatLabels           ChatLabel[]
  reports              MonitoringAlert[]           @relation("AlertChat")
  SupportTicket        SupportTicket[]
  confidentialAccesses ListingConfidentialAccess[]

  /// Team member who looks after this conversation. Mirrors the same idea on
  /// Listing, so "chats managed by X" is a real filter and not a guess from
  /// who happened to open it (that is what ChatMonitor records).
  responsible   User?   @relation("ChatResponsible", fields: [responsibleId], references: [id])
  responsibleId String?

  // Conversation list filters by buyer (userId) or seller (sellerId).
  @@index([userId])
  @@index([sellerId])
  @@index([responsibleId])
  /// Every card in the feed asks "how many people contacted this listing", so
  /// this is read once per listing per page load. Without it that question is
  /// a collection scan.
  @@index([listingId])
}

/// One person's own view of one conversation.
///
/// Everything here belongs to `userId` alone. `Chat.status` is shared by the
/// buyer, the seller and the team, so it can never say "I have filed this
/// away" — when it was used for archiving, one side archiving a chat took it
/// out of the other side's list as well, and an admin tidying their queue hid
/// the conversation from both people trading in it.
///
/// The row already existed for the label, and it is already unique per
/// (chat, user), so it is where the personal flags belong.
model ChatLabel {
  id     String @id @default(uuid()) @map("_id")
  chatId String
  userId String

  label      ChatLabelType?
  /// Filed away by this person. Their list hides it; nobody else is affected.
  archived   Boolean        @default(false)
  /// Held at the top of this person's list. A private bookmark, not a signal
  /// to the team — `Chat.responsible` and the status label do that job.
  pinned     Boolean        @default(false)
  /// When it was pinned, so several pinned chats keep a sensible order.
  pinned_at  DateTime?
  /// Goes with its conversation. Without it, deleting a listing — which takes
  /// its conversations with it — was refused outright.
  chat       Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@unique([chatId, userId])
  /// The conversation list asks "my rows for these chats" on every load.
  @@index([userId])
}

model Message {
  id        String      @id @default(uuid()) @map("_id")
  /// Goes with its conversation, for the same reason as ChatLabel.chat.
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  // Optional because the platform itself posts messages — a blocked-message
  // notice, the periodic reminder — and those have no human behind them.
  // A stand-in "system" user account was the alternative, but it would then
  // turn up in participant lists, member counts and moderation screens.
  sender    User?       @relation("Sender", fields: [senderId], references: [id])
  senderId  String?
  content   String?
  type      MessageType @default(TEXT)
  fileUrl   String? // for file/image type messages
  metadata  Json?
  delivered Boolean     @default(false)
  read      Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([chatId, senderId, createdAt])
}

/// How a prohibited word is grouped on the Detect Words screen. The four the
/// admin UI already offers — not invented here.
enum ProhibitedWordCategory {
  CONTACT_INFO
  PAYMENT_METHODS
  EXTERNAL_PLATFORMS
  OTHER
}

model ProhibitedWord {
  id         String                 @id @default(uuid()) @map("_id")
  word       String
  /// The admin screen has always offered a category and a filter; there was no
  /// column behind either, so choosing one saved nothing and filtering by one
  /// matched nothing.
  category   ProhibitedWordCategory @default(OTHER)
  /// How many messages this word has stopped. Counted once per blocked message,
  /// not once per occurrence: the number answers "is this rule earning its
  /// place", and three hits in one message would treble the same event.
  usageCount Int                    @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([category])
}

model ChatMonitor {
  id        String @id @default(uuid()) @map("_id")
  monitor   User   @relation("ChatMonitor", fields: [monitorId], references: [id])
  monitorId String

  viewedAt DateTime @default(now())

  chatId String
  /// Goes with its conversation, for the same reason as ChatLabel.chat.
  Chat   Chat   @relation("MoniteredChat", fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, monitorId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  OFFER
  ADMIN
  // Posted by the platform, not by a person. Persisted like any other message
  // so it is still there after a refresh.
  SYSTEM
}

enum ChatLabelType {
  GOOD
  BAD
  MEDIUM
}

model SupportTicket {
  id         String       @id @default(uuid()) @map("_id")
  userId     String
  chatRoomId String?
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  user     User        @relation(fields: [userId], references: [id])
  chatRoom Chat?       @relation(fields: [chatRoomId], references: [id])
  files    TicketFile?
}

model TicketFile {
  id              String         @id @default(uuid()) @map("_id")
  name            String?
  path            String?
  urls            String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  SupportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id])
  supportTicketId String?        @unique
}

model Notification {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error, message
  read      Boolean  @default(false)
  link      String?
  chatId    String? // Link to chat if it's a message notification
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read, createdAt])
}

model UserSubscription {
  id     String @id @default(uuid()) @map("_id")
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Stripe data
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Subscription status
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)

  // Dates
  startDate   DateTime  @default(now())
  endDate     DateTime?
  cancelledAt DateTime?
  trialEndsAt DateTime?

  // A downgrade takes effect at the end of the paid period, not on the click.
  // Until then the member keeps what they paid for, the page can say
  // "Downgrade starts in N days", and they can still change their mind —
  // none of which is possible without remembering the pending change.
  pendingPlanId       String?
  pendingBillingCycle BillingCycle?
  pendingChangeAt     DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model Payment {
  id     String @id @default(uuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Stripe data
  stripePaymentIntentId String? @unique
  stripeInvoiceId       String?
  stripeChargeId        String?

  // Payment details
  amount   String
  currency String        @default("usd")
  status   PaymentStatus @default(PENDING)

  // Related subscription
  planId         String?
  plan           Plan?   @relation(fields: [planId], references: [id])
  subscriptionId String?

  billingCycle BillingCycle?
  description  String?

  // Metadata
  metadata Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// A document attached to a listing, held privately.
///
/// Attachments used to be nothing but a URL inside a question's answer, and
/// that URL was public: a contract or a P&L could be read by anyone holding
/// the link, with no account at all. The bytes still live on the CDN, but the
/// asset is delivered privately and reaching it goes through the API, which
/// applies the same rule that decides whether the page itself is unblurred.
///
/// Listing photos are deliberately not here. They are meant to be public, and
/// putting them behind a login would empty every card on the marketplace.
model Attachment {
  id        String  @id @default(uuid()) @map("_id")
  /// The listing it belongs to. Empty while that listing is still being
  /// written — a document uploaded in the wizard before its first save — and
  /// for files that belong to a conversation or to their uploader alone.
  listingId String?
  /// Who uploaded it; empty for a guest writing a listing before signing up.
  /// A file not on a listing yet can be read by this person and the team only.
  ownerId   String?
  /// The conversation a chat attachment was sent in: its members may read it.
  chatId    String?
  /// "listing", "chat" or "acquisition" — which rule decides who may read it.
  purpose   String  @default("listing")

  /// What the seller called the file, kept as they typed it.
  ///
  /// The name used to be read back out of the URL, which is why a `.jpeg`
  /// arrived as `.jpg` and a name with punctuation came back hyphenated. The
  /// URL is a storage detail; this is the file's name.
  fileName String
  mimeType String?
  bytes    Int?

  /// Where the bytes are: the CDN's id, and which pipeline delivers it.
  publicId     String
  resourceType String @default("raw")
  /// "authenticated" once migrated; "upload" while a file is still public.
  deliveryType String @default("authenticated")

  /// The question whose answer this file belongs to, so an older answer that
  /// stores a URL can still be matched to the row that replaced it.
  questionId String?
  /// The public URL this file used to live at, kept only so the migration can
  /// find and rewrite the answers that still point there.
  legacyUrl String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([publicId])
  @@index([ownerId])
  @@index([chatId])
}

/// One placement the seller is paying for, on a subscription of its own.
///
/// This used to be a single set of fields on the listing — `packageAddons[0]`
/// with one Stripe id, one billing cycle and one end date beside it — which
/// could only ever describe one placement at a time. The client's design shows
/// a seller holding the category page and the start page together, each
/// renewing on its own date and each cancellable on its own, so each one needs
/// its own row.
model ListingAddon {
  id        String @id @default(uuid()) @map("_id")
  listingId String

  /// CATEGORY_PAGE | START_PAGE | BUNDLE.
  addon String

  /// MONTHLY | THREE_MONTH | SIX_MONTH — its own, never the package's.
  billingCycle String @default("MONTHLY")

  /// ACTIVE while it renews; ENDING once cancelled but still running out the
  /// period already paid for. The row goes only when that period is over.
  status String @default("ACTIVE")

  stripeSubscriptionId String?

  /// When Stripe bills it next — what "Renews in 42 Days" counts towards.
  currentPeriodEnd DateTime?

  /// The day a cancelled placement actually goes. Null while it is renewing.
  endsAt DateTime?

  /// A move to a shorter cycle, waiting for the period already paid for.
  ///
  /// Going from six months to monthly changes nothing about the placement
  /// itself, only how often it is billed — so there is no reason to refund
  /// and restart. The current period runs out and the new rhythm starts after
  /// it, which is the same rule the packages follow for a downgrade.
  pendingBillingCycle String?
  pendingChangeAt     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// One row per placement per listing. Buying the same one again updates this
  /// row instead of adding a second, so a retried webhook cannot bill twice.
  @@unique([listingId, addon])
  @@index([listingId])
}

/// The European Central Bank's euro reference rates, one document per working
/// day.
///
/// `rates` maps a currency code to how many units of it one euro bought that
/// day: { "USD": 1.1616, "GBP": 0.85915, … }. Keyed by code, never by position:
/// the ECB's list changes over time — currencies are added, some are dropped —
/// so a currency that was not quoted on a day is simply absent from that day.
/// Weekends and holidays have no document at all; nothing is filled in.
model FxDay {
  id         String   @id @default(uuid()) @map("_id")
  /// The ECB's date, at midnight UTC.
  day        DateTime @unique
  rates      Json
  created_at DateTime @default(now())
}

/// A sign-up waiting for its emailed code.
///
/// Nothing is registered until the code comes back right: only then is a User
/// made from this row, and the row deleted. An abandoned sign-up leaves no
/// account behind, and signing up again with the address starts it over.
model PendingSignup {
  id             String    @id @default(uuid()) @map("_id")
  email          String    @unique
  first_name     String
  last_name      String
  password_hash  String
  business_name  String?
  /// A listing the visitor was about to publish as a guest when they signed
  /// up: the same body "create listing" takes, already checked. It becomes a
  /// DRAFT listing in the new account the moment the code is confirmed —
  /// wherever and whenever that happens — so nothing depends on the browser
  /// the listing was typed in. Deleted with the sign-up if it is never confirmed.
  listing_draft  Json?
  otp_code       String?
  otp_expires_at DateTime?
  otp_attempts   Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

/// A sentence for one figure on the published ad, written by an administrator.
///
/// Every other ⓘ on an ad belongs to a question and takes its wording from the
/// question's `publicHint`. The summary figures are worked out rather than
/// answered — the margin from the P&L table, the multiples from the asking
/// price, the age from the starting date — so no question stands behind them,
/// and their sentences used to live in the page's code where nobody could edit
/// them.
///
/// One row per figure, the id being the page's own name for it. A figure
/// nobody has written about has no row at all, and the page keeps the sentence
/// it came with.
model AdFieldHint {
  /// The figure's key, such as `profitMargin`. Fixed by the page, never generated.
  id         String   @id @map("_id")
  text       String
  updated_at DateTime @updatedAt
}
